class Student:
    def __init__(self, name, roll_number, age, marks):
        self.name = name
        self.roll_number = roll_number
        self.age = age
        self.marks = marks

    def display_info(self):
        print(f"Name: {self.name} | Roll: {self.roll_number} | Age: {self.age} | Marks: {self.marks}")

    def update_marks(self, new_marks):
        if 0 <= new_marks <= 100:
            self.marks = new_marks
            print("Marks updated successfully.")
        else:
            print("Invalid marks. Must be between 0 and 100.")

    def get_grade(self):
        if self.marks >= 90:
            return "A"
        elif self.marks >= 75:
            return "B"
        elif self.marks >= 60:
            return "C"
        elif self.marks >= 40:
            return "D"
        else:
            return "F"


